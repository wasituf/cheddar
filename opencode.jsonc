{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"agent": {
		"build": {
			"model": "azure/gpt-6.1-sol",
			"variant": "medium"
		},
		"implementer": {
			"description": "Implements a single, well-scoped task with the smallest possible, most readable change.",
			"mode": "subagent",
			"model": "azure/gpt-6-luna",
			"temperature": 0.1,
			"prompt": "You implement exactly one scoped task. Write the smallest, simplest change that meets the acceptance criteria. Reuse existing code and patterns. Do not add abstractions, extra files, speculative options, unnecessary error handling, or comments that restate code. Do not touch unrelated code. Keep tests focused on real behaviour. Before finishing, reread your diff and delete anything that is not required. Report files changed, lines added/removed, and test results."
		},
		"explore": {
			"model": "azure/gpt-6-luna"
		},
		"scout": {
			"model": "azure/gpt-6-luna",
			"mode": "subagent"
		},
		"plan": {
			"prompt": "When you finish planning, save the full plan to `.opencode/plans/<kebab-case-name>.md`. Use a short descriptive filename (no dates). The file should include: title, goal summary, step-by-step implementation plan, and any constraints/decisions. When resuming work, check `.opencode/plans/` for the latest plan first.",
			"mode": "primary",
			"permission": {
				"edit": {
					".opencode/plans/**": "allow",
					"*": "deny"
				}
			}
		},
		"ask": {
			"prompt": "You answer any questions regarding any plans, implementations, or general application functions. Read any relevant files required to answer the questions. Answer each question with precision and accuracy. Answer briefly. Avoid vague answers. Do NOT write to any file.",
			"mode": "primary",
			"model": "azure/gpt-6.1-sol",
			"permission": {
				"edit": {
					"*": "deny",
					".opencode/plans/**": "allow"
				}
			}
		}
	},
	"mcp": {},
	"permission": {
		"bash": "ask",
		"edit": "ask",
		"write": "allow"
	}
}
